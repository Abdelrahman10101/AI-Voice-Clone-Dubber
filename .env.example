# Google Gemini API Key (Required for Gemini Audio Transcriber and Gemma 4 31B)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# STT Model (Gemini 3.5 Transcribe)
GEMINI_STT_MODEL=gemini-3.5-transcribe

# Translation Engine: 'gemini_api' or 'ollama'
TRANSLATION_ENGINE=gemini_api

# Translation Model (via Gemini API or Ollama)
TRANSLATION_MODEL=gemma-4-31b-it

# Local Ollama URL (used if TRANSLATION_ENGINE=ollama)
OLLAMA_URL=http://localhost:11434
